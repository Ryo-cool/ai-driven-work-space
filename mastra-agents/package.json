  "license": "ISC",
  "description": "",
  "type": "module",
  "engines": {
    "node": ">=20.9.0"
  },
  "dependencies": {
    "@ai-sdk/openai": "^1.3.22",
    "@mastra/core": "^0.10.5",
    "@mastra/libsql": "^0.10.2",
    "@mastra/memory": "^0.10.3",
    "cors": "^2.8.5",
    "express": "^5.1.0",
    "zod": "^3.25.61"
  },
  "devDependencies": {
    "@jest/globals": "^30.0.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/jest": "^29.5.14",
    "@types/node": "^24.0.0",
    "jest": "^30.0.0",
    "mastra": "^0.10.5",
